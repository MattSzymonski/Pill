#!/bin/sh
# Git calls this hook name when a message exists, and `pre-commit` when it does
# not, so the message checks live in `pre-commit` beside this file and this is
# only the name git needs. One file holds every rule of the commit policy.
#
# Enable both with: git config --local core.hooksPath devops/hooks

exec "$(dirname "$0")/pre-commit" --commit-message "$1"
