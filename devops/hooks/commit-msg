#!/bin/sh
# Refuses a commit message whose first line breaks the repository's commit
# standard.
#
# # Responsibilities
#
# - Refuses a first line that is not `<type>(<scope>): <description>`.
# - Refuses a type or scope the contributing guide does not define.
# - Refuses a description that starts uppercase, ends with a period, or runs
#   longer than the word limit.
#
# # Design
#
# Git passes the path of the message file as the first argument and abandons the
# commit when this hook exits non-zero. Only the first line is checked, because
# that is what the guide pins down; the body and footers stay with the author
# and the reviewer. The types and scopes come from policy.env beside this hook,
# which the other hooks and the gate read too, so the vocabulary has one home.
# Git's own messages - merges, generated reverts, autosquash markers - are left
# alone: their shape is not ours to choose.

set -e

# =============================================================================
# Constants
# =============================================================================

# The description's length, in words, from the contributing guide. A longer
# first line is usually two commits sharing one.
MESSAGE_MAX_WORDS=10

# The policy beside this hook. It defines COMMIT_TYPES and COMMIT_SCOPES.
POLICY_FILE_NAME="policy.env"

# =============================================================================
# Policy
# =============================================================================

hooks_directory=$(dirname "$0")

# Sources the vocabulary the checks read.
#
# A missing policy file stops the commit: without the lists there is no standard
# to check against, and accepting everything would be worse than stopping.
load_policy() {
    policy_file="$hooks_directory/$POLICY_FILE_NAME"
    if [ ! -f "$policy_file" ]; then
        cat >&2 <<'MISSING'
commit message refused: devops/hooks/policy.env is missing.
  The hook reads the allowed types and scopes from that file.
  fix: restore the file from the repository (it is tracked), then commit again.
MISSING
        exit 1
    fi
    . "$policy_file"
}

# =============================================================================
# Refusals
# =============================================================================

# States the rule, the vocabulary it allows, and the line that broke it.
refuse_message() {
    cat >&2 <<EOF
commit message refused: $1
  The first line follows Conventional Commits, as the contributing guide says:
  <type>(<scope>): <description>, imperative, lowercase, no period, ten words at
  most; leave the scope out when no feature owns the change, and put ! before
  the colon for a breaking change.
  types:  $COMMIT_TYPES
  scopes: $COMMIT_SCOPES, or extension:<name>
  This commit: $2
EOF
    exit 1
}

# =============================================================================
# Checks
# =============================================================================

# Refuses a message file whose first line breaks the standard.
check_commit_message() {
    message_file="$1"

    # Step 1: read the first line that is neither a comment nor blank.
    first_line=$(grep -v '^#' "$message_file" | sed '/^[[:space:]]*$/d' | head -n 1)

    # Step 2: leave git's own messages alone - a merge, a revert it generated,
    # and the markers autosquash needs - and accept an empty file, which git
    # refuses by itself.
    case "$first_line" in
        '') return 0 ;;
        Merge\ * | Revert\ \"* | fixup!\ * | squash!\ *) return 0 ;;
    esac

    # Step 3: check the shape before reading anything out of it.
    if ! printf '%s\n' "$first_line" | grep -Eq '^[a-z]+(\([a-z_:]+\))?!?: .+$'; then
        refuse_message "the first line does not read <type>(<scope>): <description>" "$first_line"
    fi

    # Step 4: split the line into its type, its scope and its description. An
    # extension scope contains a colon of its own (`fix(extension:audio): ...`),
    # so the description starts after the scope's closing parenthesis when there
    # is one, and after the first colon otherwise.
    commit_type=$(printf '%s\n' "$first_line" | sed -n 's/^\([a-z][a-z]*\).*/\1/p')
    commit_scope=$(printf '%s\n' "$first_line" | sed -n 's/^[a-z][a-z]*(\([^)]*\)).*/\1/p')
    case "$first_line" in
        *'): '*) description=${first_line#*'): '} ;;
        *) description=${first_line#*': '} ;;
    esac

    # Step 5: the type must be one the guide defines.
    type_known=0
    for known_type in $COMMIT_TYPES; do
        if [ "$commit_type" = "$known_type" ]; then
            type_known=1
        fi
    done
    if [ "$type_known" -eq 0 ]; then
        refuse_message "the type '$commit_type' is not one of the guide's types" "$first_line"
    fi

    # Step 6: the scope, when there is one, must be a general scope or
    # extension:<name>.
    if [ -n "$commit_scope" ]; then
        case "$commit_scope" in
            extension:*) ;;
            *)
                scope_known=0
                for known_scope in $COMMIT_SCOPES; do
                    if [ "$commit_scope" = "$known_scope" ]; then
                        scope_known=1
                    fi
                done
                if [ "$scope_known" -eq 0 ]; then
                    refuse_message "the scope '$commit_scope' is not one of the guide's scopes" "$first_line"
                fi
                ;;
        esac
    fi

    # Step 7: the description needs text, no closing period, a lowercase first
    # character, and no more words than the guide allows.
    if [ -z "$description" ]; then
        refuse_message "there is no description after the colon" "$first_line"
    fi

    case "$description" in
        *.) refuse_message "the description ends with a period" "$first_line" ;;
    esac

    first_character=$(printf '%s' "$description" | cut -c 1)
    case "$first_character" in
        [a-z0-9]) ;;
        *) refuse_message "the description starts with '$first_character'; it is written in lowercase, and imperatively" "$first_line" ;;
    esac

    word_count=$(printf '%s' "$description" | wc -w | tr -d ' ')
    if [ "$word_count" -gt "$MESSAGE_MAX_WORDS" ]; then
        refuse_message "the description is $word_count words long; the guide allows $MESSAGE_MAX_WORDS, because a longer commit is probably two commits" "$first_line"
    fi
}

# =============================================================================
# Run
# =============================================================================

load_policy
check_commit_message "$1"
