# The commit policy, in one place: the pre-commit hook sources this file and
# devops/tests/test_commit_policy.py reads it, so the gate and the hook cannot
# disagree about the rules.
#
# Edit here, not in the two readers.

# The largest file a commit may add, in bytes: 100 KiB. Only added files are
# measured, so editing an existing large file is allowed; the gate
# (devops/tests/test_commit_policy.py) reads the same rule the same way.
SIZE_LIMIT_BYTES=102400

# The only example projects a commit may touch. A project is one folder under
# examples/; files directly in examples/ (the README) are unaffected.
EXAMPLE_PROJECTS="cube cube_no_editor headless pills"

# The first line's type and scope, read by devops/hooks/commit-msg. Keep them
# equal to the tables in
# Pill-Docs/guide/other/contributing/repository-standards.md.
COMMIT_TYPES="feat fix perf refactor test docs build ci chore revert"
COMMIT_SCOPES="ecs scripting play_mode hot_reload assets host telemetry renderer ui editor csharp input web shipping devops examples"
