#!/bin/sh
# Refuses a commit that breaks the repository's commit policy:
#
#   1. the shipping bundle crate must be the project-agnostic stub, never a
#      generation (a generation names one project and would let the shipping
#      posture type-check against whichever was generated last);
#   2. no staged file may be larger than SIZE_LIMIT_BYTES;
#   3. only the example projects listed in policy.env may be committed under
#      examples/.
#
# The rules themselves live in `policy.env` beside this hook, which the gate's
# `commit-policy` step reads too, so the two cannot disagree. It reads the index,
# not the working tree, so committing other files while a generation sits in the
# tree still works.
#
# Enable it once per clone:
#   git config --local core.hooksPath devops/hooks

set -e
stub_refused=0
size_refused=0
examples_refused=0

# The policy lives in one file beside this hook, shared with the gate's
# `commit-policy` step (`devops/tests/test_commit_policy.py`).
hooks_directory=$(dirname "$0")
if [ -f "$hooks_directory/policy.env" ]; then
    . "$hooks_directory/policy.env"
else
    echo "commit refused: $hooks_directory/policy.env is missing." >&2
    exit 1
fi

check_stub() {
    path="$1"
    marker="$2"
    if git cat-file -e ":$path" 2>/dev/null; then
        if ! git cat-file -p ":$path" | grep -q "$marker"; then
            echo "commit refused: $path is a generated bundle, not the stub." >&2
            stub_refused=1
        fi
    fi
}

check_size() {
    staged=$(git diff --cached --name-only --diff-filter=AM)
    while IFS= read -r path; do
        [ -n "$path" ] || continue
        size=$(git cat-file -s ":$path" 2>/dev/null || echo 0)
        if [ "$size" -gt "$SIZE_LIMIT_BYTES" ]; then
            echo "commit refused: $path is $size bytes, over the $SIZE_LIMIT_BYTES-byte limit." >&2
            size_refused=1
        fi
    done <<EOF
$staged
EOF
}

check_stub build/pill_shipping_bundle/src/lib.rs "committed stub"
check_stub build/pill_shipping_bundle/Cargo.toml "committed face of the shipping bundle"
check_size

check_examples() {
    staged=$(git diff --cached --name-only --diff-filter=AM)
    while IFS= read -r path; do
        [ -n "$path" ] || continue
        case "$path" in
            examples/*/*)
                rest=${path#examples/}
                project=${rest%%/*}
                allowed=0
                for name in $EXAMPLE_PROJECTS; do
                    if [ "$project" = "$name" ]; then
                        allowed=1
                    fi
                done
                if [ "$allowed" -eq 0 ]; then
                    echo "commit refused: $path is in examples/$project, which is not one of the allowed example projects." >&2
                    examples_refused=1
                fi
                ;;
        esac
    done <<EOF
$staged
EOF
}

check_examples

if [ "$stub_refused" -ne 0 ]; then
    echo "put the stub back first: python devops/tools/generate_shipping_bundle.py --restore-stub" >&2
fi
if [ "$size_refused" -ne 0 ]; then
    echo "split the file, or raise SIZE_LIMIT_BYTES in devops/hooks/policy.env" >&2
fi
if [ "$examples_refused" -ne 0 ]; then
    echo "allowed example projects: $EXAMPLE_PROJECTS" >&2
fi
if [ "$stub_refused" -ne 0 ] || [ "$size_refused" -ne 0 ] || [ "$examples_refused" -ne 0 ]; then
    exit 1
fi
