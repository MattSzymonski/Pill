# The commit policy, in one place: the pre-commit hook sources this file and
# devops/tests/test_commit_policy.py reads it, so the gate and the hook cannot
# disagree about the rules.
#
# Edit here, not in the two readers.

# The largest file a commit may stage, in bytes: 100 KiB. Strict - no path is
# exempt, so a change to an existing large file is refused too.
SIZE_LIMIT_BYTES=102400

# The only example projects a commit may touch. A project is one folder under
# examples/; files directly in examples/ (the README) are unaffected.
EXAMPLE_PROJECTS="cube cube_no_editor headless pills"
